# Server
HTTP_PORT=8080

# Database
DATABASE_URL=postgres://social:social@localhost:5432/social_api
READ_DATABASE_URL=postgres://social:social@localhost:5432/social_api

# Redis
REDIS_URL=redis://localhost:6379

# Content API URLs (one per content type)
CONTENT_API_POST_URL=http://localhost:8081
CONTENT_API_BONUS_HUNTER_URL=http://localhost:8082
CONTENT_API_TOP_PICKS_URL=http://localhost:8083

# Profile API
PROFILE_API_URL=http://localhost:8084

# Rate Limiting
RATE_LIMIT_WRITE=30
RATE_LIMIT_READ=1000

# Cache TTLs (seconds)
CACHE_TTL_COUNT=60
CACHE_TTL_CONTENT_VALIDATION=300

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_FAILURE_RATE_THRESHOLD=50
CB_OPEN_DURATION_SECS=30
CB_HALF_OPEN_SUCCESSES=3
